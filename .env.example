# ============================================================================
# H1-multilevel (AgentFlow AI) — Safe Environment Variable Template
# ============================================================================
# SECURITY NOTICE:
# 1. Copy this file to `.env` for local development (`cp .env.example .env`).
# 2. NEVER commit `.env`, `firebase-applet-config.json`, or `firebase-applet-config.js`
#    containing real API keys to Git.
# 3. Static GitHub Pages deployments run 100% in the user's browser and CANNOT
#    securely hide private API keys (such as GEMINI_API_KEY). Keep GEMINI_API_KEY
#    strictly on a secure backend server or serverless proxy.
# ============================================================================

# --- Server-Side Only (Express Backend / Serverless Proxy) ---
# NEVER prefix GEMINI_API_KEY with VITE_ or expose it in frontend code.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"
APP_URL="http://localhost:3000"

# --- Optional Secure Backend Proxy URL for Static GitHub Pages Frontend ---
# If deploying the frontend to GitHub Pages and hosting `server.ts` on Cloud Run / Render / Fly.io,
# set this to your backend origin (e.g. "https://your-secure-backend.run.app").
# Leave empty on GitHub Pages to use built-in client-side multi-agent orchestration safely.
VITE_API_BASE_URL=""

# --- Optional Client-Side Firebase Cloud History Sync ---
# Leave empty to run in local browser persistence mode without Firebase.
VITE_FIREBASE_API_KEY="YOUR_FIREBASE_API_KEY_HERE"
VITE_FIREBASE_AUTH_DOMAIN="YOUR_PROJECT_ID.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="YOUR_PROJECT_ID"
VITE_FIREBASE_STORAGE_BUCKET="YOUR_PROJECT_ID.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="YOUR_MESSAGING_SENDER_ID"
VITE_FIREBASE_APP_ID="YOUR_FIREBASE_APP_ID"
VITE_FIREBASE_DATABASE_ID="(default)"
